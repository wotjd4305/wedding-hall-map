rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 공유 링크의 방 ID(#r=...)를 아는 사람만 읽고 쓸 수 있음. 방 목록 조회는 불가.
    match /rooms/{room}/venues/{venue} {
      allow read, delete: if room.size() >= 16;
      allow create, update: if room.size() >= 16
        && request.resource.data.keys().hasOnly(['status', 'meal', 'rent', 'guests', 'memo', 'updatedAt', 'updatedBy'])
        && (!('memo' in request.resource.data) || (request.resource.data.memo is string && request.resource.data.memo.size() <= 3000))
        && (!('updatedBy' in request.resource.data) || (request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 20))
        && (!('status' in request.resource.data) || request.resource.data.status in ['fav', 'call', 'tour', 'pick', 'nope']);
    }

    // 접속자 표시 (하트비트)
    match /rooms/{room}/presence/{client} {
      allow read, delete: if room.size() >= 16;
      allow create, update: if room.size() >= 16
        && request.resource.data.keys().hasOnly(['name', 'lastSeen'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
    }

    // 웨딩홀 위치 보정 캐시 (구글 장소검색 결과) — 모두 읽기, 형식 맞으면 쓰기
    match /geo/{venue} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['lat', 'lng', 'addr'])
        && request.resource.data.lat is number && request.resource.data.lat > 33 && request.resource.data.lat < 39
        && request.resource.data.lng is number && request.resource.data.lng > 124 && request.resource.data.lng < 132
        && (!('addr' in request.resource.data) || (request.resource.data.addr is string && request.resource.data.addr.size() <= 300));
    }
  }
}
